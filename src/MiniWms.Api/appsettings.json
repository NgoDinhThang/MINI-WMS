{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 }
                },
    "AllowedHosts":  "*",
    "Jwt":  {
                "Issuer":  "MiniWms.Api",
                "Audience":  "MiniWms.Client"
            },
    "Authentication":  {
                           "AccessTokenMinutes":  15,
                           "SessionLifetimeHours":  8,
                           "LoginPermitLimit":  60
                       },
    "Redis":  {
                  "KeyPrefix":  "miniwms:auth:"
              }
}
